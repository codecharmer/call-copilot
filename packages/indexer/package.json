{
  "name": "@call-copilot/indexer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Index worker: repository discovery, ignore policy, secret filtering, tree-sitter parsing, chunking, local embeddings, incremental updates, atomic index generations.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "@call-copilot/contracts": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./src/index.ts",
  "main": "./dist/index.js"
}
